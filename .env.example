# Copy to .env and fill in. Only the key for the provider you use is needed.
GEMINI_API_KEY=
PROMO_MODEL=gemini:gemini-3.8-flash
# GEMINI_THINKING=medium        # minimal | low | medium | high
# GEMINI_TIMEOUT=90             # seconds before switching to the fallback model
# PROMO_RPM=9                   # requests/minute throttle for free tiers
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Deployed only: comma-separated origins allowed to call the API (your Vercel URL)
ALLOWED_ORIGINS=
